# direnv configuration for DHRASHTA-X
# Integrates Nix flake devShell with Android SDK / JDK environment

if has nix; then
  use flake
fi

# Source Android SDK & JDK paths across Linux, macOS, and Windows
if [ -f scripts/android-env.sh ]; then
  # shellcheck source=/dev/null
  source scripts/android-env.sh
fi

# Ensure project scripts are directly available on PATH
PATH_add scripts
